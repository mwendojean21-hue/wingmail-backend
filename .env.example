# Copie ce fichier en ".env" et remplis les valeurs

DATABASE_URL=postgresql://wingmail_user:change_me@localhost:5432/wingmail

# Secret utilisé pour signer les tokens JWT - genere une longue chaine aleatoire
JWT_SECRET=change_me_super_secret_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS - domaines autorises a appeler l'API (frontend web / app packagee)
CORS_ORIGINS=http://localhost:5173,http://localhost,capacitor://localhost

# Noms d'utilisateur automatiquement promus administrateur (separes par des virgules)
ADMIN_USERNAMES=erickbenoit337

# URL publique du frontend, utilisee pour generer les liens de parrainage
FRONTEND_URL=https://wingmail.onrender.com

# Depot GitHub verifie pour la recompense "etoile" (format: proprietaire/depot)
GITHUB_REPO=erickbenoit337/wingmail

# Cle pour les tuiles de carte (optionnel, on utilise OpenStreetMap gratuit par defaut)
MAPTILER_KEY=
